# Esempio di reverse proxy nginx per Wedding Gallery.
# Sostituisci "gallery.tuodominio.it" con il tuo dominio (o IP) reale.
# Per HTTPS gratuito, dopo aver messo online questo blocco, usa certbot:
#   sudo pacman -S certbot certbot-nginx
#   sudo certbot --nginx -d gallery.tuodominio.it

server {
    listen 80;
    server_name gallery.tuodominio.it;

    client_max_body_size 30m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
